/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "Qualcomm Technologies, Inc. Haotian based on SM8750";
	qcom,board-id = <0x40008 0x00>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "qcom,sun-mtp", "qcom,sun", "qcom,sunp-mtp", "qcom,sunp", "qcom,mtp";
	qcom,msm-id = <0x100026a 0x20000 0x27f 0x10000 0x26a 0x10000 0x27f 0x20000 0x26a 0x20000 0x100027f 0x10000 0x100026a 0x10000 0x100027f 0x20000>;

	mem-offline {
		qcom,qmp = <0x19>;
		offline-sizes = <0x02 0xc0000000 0x01 0x00>;
		granule = <0x400>;
		compatible = "qcom,mem-offline";
		status = "disabled";
	};

	soc: soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		interrupt-parent = <0x01>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0xffffffff>;
		phandle = <0x376>;

		qup1_gpi_iommu_region: qup1_gpi_iommu_region {
			phandle = <0x270>;
			iommu-addresses = <0x26f 0x00 0x100000 0x26f 0x200000 0xffe00000>;
		};

		nsp_noc: interconnect@320c0000 {
			#interconnect-cells = <0x01>;
			qcom,bcm-voters = <0x29>;
			compatible = "qcom,sun-nsp_noc";
			reg = <0x320c0000 0x13080>;
			phandle = <0x9d>;
			qcom,bcm-voter-names = "hlos";
		};

		cam_ipe0: qcom,ipe0@ac42000 {
			ipe0-vdd-supply = <0x43c>;
			clock-control-debugfs = "true";
			clock-names = "ipe_nps_ahb_clk", "ipe_nps_fast_ahb_clk", "ipe_pps_fast_ahb_clk", "ipe_nps_clk_src", "ipe_nps_clk", "ipe_pps_clk", "cam_cc_camnoc_nrt_ipe_nps_clk";
			reg-names = "ipe0_top";
			reg-cam-base = <0x42000>;
			cell-index = <0x00>;
			clocks = <0x42 0x43 0x42 0x46 0x42 0x48 0x42 0x45 0x42 0x44 0x42 0x47 0x42 0x05>;
			clock-cntl-level = "lowsvsd1", "lowsvs", "svs", "svs_l1", "nominal", "turbo";
			cam_hw_pid = <0x0f 0x0e 0x1a 0x1b>;
			compatible = "qcom,cam-ipe680";
			src-clock-name = "ipe_nps_clk_src";
			status = "ok";
			reg = <0xac42000 0x18000>;
			regulator-names = "ipe0-vdd";
			phandle = <0x648>;
			nrt-device;
			clock-rates = <0x00 0x00 0x00 0x13d18c20 0x00 0x00 0x00 0x00 0x00 0x00 0x1c4fecc0 0x00 0x00 0x00 0x00 0x00 0x00 0x2245cdc0 0x00 0x00 0x00 0x00 0x00 0x00 0x283baec0 0x00 0x00 0x00 0x00 0x00 0x00 0x312c8040 0x00 0x00 0x00 0x00 0x00 0x00 0x312c8040 0x00 0x00 0x00>;
		};

		pmic-pon-log {
			depends-on-supply = <0x568>;
			nvmem-names = "pon_log0", "pon_log1";
			compatible = "qcom,pmic-pon-log";
			nvmem = <0x675 0x676>;
		};

		cam_csiphy5: qcom,csiphy5@adb3000 {
			csi-vdd-1p2-supply = <0x40>;
			rgltr-max-voltage = <0x00 0x132a40 0xe09c0>;
			csi-vdd-0p9-supply = <0x34a>;
			clock-names = "cphy_rx_clk_src", "csiphy5_clk", "csi5phytimer_clk_src", "csi5phytimer_clk";
			reg-names = "csiphy";
			reg-cam-base = <0x1b3000>;
			cell-index = <0x05>;
			interrupts = <0x00 0x59 0x01>;
			clocks = <0x42 0x1a 0x42 0x32 0x42 0x29 0x42 0x28>;
			rgltr-load-current = <0x00 0x1838 0x15888>;
			gdscr-supply = <0x5e>;
			rgltr-cntrl-support;
			clock-cntl-level = "lowsvsd1", "lowsvs", "nominal";
			compatible = "qcom,csiphy-v2.3.0", "qcom,csiphy";
			rgltr-min-voltage = <0x00 0x124f80 0xd6d80>;
			src-clock-name = "cphy_rx_clk_src";
			status = "ok";
			interrupt-names = "CSIPHY5";
			reg = <0xadb3000 0x2000>;
			regulator-names = "gdscr", "csi-vdd-1p2", "csi-vdd-0p9";
			phandle = <0x5fe>;
			shared-clks = <0x01 0x00 0x00 0x00>;
			clock-rates = <0xfe502ab 0x00 0x17d78400 0x00 0x17d78400 0x00 0x17d78400 0x00 0x1c9c3800 0x00 0x17d78400 0x00>;
		};

		cti@10961000 {
			arm,primecell-periphid = <0xbb922>;
			clock-names = "apb_pclk";
			clocks = <0x19>;
			coresight-name = "coresight-cti-a6x_isdb";
			compatible = "arm,coresight-cti", "arm,primecell";
			status = "disabled";
			reg = <0x10961000 0x1000>;
		};

		qcom,gh-qtimer@1680b000 {
			qcom,primary;
			reg-names = "qtmr-base";
			interrupts = <0x00 0x0d 0x04>;
			compatible = "qcom,gh-qtmr";
			interrupt-names = "qcom,qtmr-intr";
			reg = <0x1680b000 0x1000>;
		};

		cam_jpeg_enc0: qcom,jpegenc0@ac25000 {
			cam_hw_rd_mid = <0x00>;
			clock-names = "jpegenc_clk_src", "jpegenc_0_clk", "jpegenc_1_clk";
			reg-names = "jpegenc_hw", "cam_camnoc_nrt";
			reg-cam-base = <0x25000 0x62000>;
			cell-index = <0x00>;
			interrupts = <0x00 0x1db 0x01>;
			clocks = <0x42 0x4b 0x42 0x49 0x42 0x4a>;
			clock-cntl-level = "nominal";
			cam_hw_pid = <0x11 0x13>;
			compatible = "qcom,cam_jpeg_enc_780";
			gdsc-supply = <0x5e>;
			src-clock-name = "jpegenc_clk_src";
			status = "ok";
			interrupt-names = "jpeg_enc0";
			reg = <0xac25000 0x1000 0xac62000 0x9200>;
			regulator-names = "gdsc";
			phandle = <0x64a>;
			nrt-device;
			shared-clks = <0x01 0x00 0x00>;
			clock-rates = <0x23c34600 0x00 0x00>;
			cam_hw_wr_mid = <0x01>;
		};

		cam_crm: crm@adcb000 {
			qcom,hw-drv-ids = <0x00 0x01 0x02>;
			reg-names = "base", "crm_b", "crm_b_pt", "crm_c", "crm_v", "common";
			interrupts = <0x00 0x79 0x01>;
			clocks = <0x42 0x33>;
			label = "cam_crm";
			qcom,sw-drv-ids = <0x00>;
			compatible = "qcom,cam-crm-v2";
			interrupt-names = "cam_crm_drv0";
			reg = <0xadcb000 0x1e00 0xadcce00 0x400 0xadcd200 0x400 0xadcd600 0x2000 0xadcf600 0x700 0xadcfd00 0x100>;
			phandle = <0x435>;
		};

		tpdm_spss: tpdm@10880000 {
			arm,primecell-periphid = <0xbb968>;
			clock-names = "apb_pclk";
			reg-names = "tpdm-base";
			clocks = <0x19>;
			coresight-name = "coresight-tpdm-spss";
			compatible = "arm,primecell";
			status = "disabled";
			reg = <0x10880000 0x1000>;
			phandle = <0x4a3>;

			out-ports {

				port {

					tpdm_spss_out_funnel_spss: endpoint {
						remote-endpoint = <0x158>;
						phandle = <0x159>;
					};
				};
			};
		};

		etm@12d21000 {
			clock-names = "apb_pclk";
			qcom,skip-power-up;
			clocks = <0x19>;
			cpu = <0x11>;
			coresight-name = "coresight-etm1";
			compatible = "arm,coresight-etm4x-sysreg";

			out-ports {

				port {

					etm1_out_funnel_etm1: endpoint {
						remote-endpoint = <0x186>;
						phandle = <0x189>;
					};
				};
			};
		};

		tcsr_mutex: hwlock {
			syscon = <0x20 0x00 0x1000>;
			compatible = "qcom,tcsr-mutex";
			phandle = <0x18>;
			#hwlock-cells = <0x01>;
		};

		apps_rsc: rsc@16500000 {
			power-domains = <0x1c>;
			reg-names = "drv-0", "drv-1", "drv-2";
			interrupts = <0x00 0x03 0x04 0x00 0x04 0x04 0x00 0x05 0x04>;
			label = "apps_rsc";
			compatible = "qcom,rpmh-rsc";
			reg = <0x16500000 0x10000 0x16510000 0x10000 0x16520000 0x10000>;
			phandle = <0x3e7>;
			qcom,drv-count = <0x03>;

			apps_rsc_drv2: drv@2 {
				qcom,drv-id = <0x02>;
				qcom,tcs-offset = <0xd00>;
				phandle = <0x3e8>;
				qcom,tcs-distance = <0x2a0>;

				rpmh-regulator-ldom4 {
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldom4";

					L4M: pm8010m_l4: regulator-pm8010m-l4 {
						regulator-max-microvolt = <0x1b7740>;
						qcom,init-voltage = <0x1b7740>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "pm8010m_l4";
						qcom,set = <0x03>;
						phandle = <0x422>;
					};
				};

				rpmh-regulator-lcxlvl {
					compatible = "qcom,rpmh-arc-regulator";
					qcom,resource-name = "lcx.lvl";

					S5I_LEVEL: VDD_LPI_CX_LEVEL: pm_v8i_s5_level: regulator-pm-v8i-s5-level {
						regulator-max-microvolt = <0xffff>;
						regulator-min-microvolt = <0x10>;
						regulator-name = "pm_v8i_s5_level";
						qcom,init-voltage-level = <0x10>;
						qcom,set = <0x03>;
						phandle = <0x8a>;
					};
				};

				rpmh-regulator-bobb2 {
					qcom,mode-threshold-currents = <0x00 0xf4240 0x1e8480>;
					qcom,regulator-type = "pmic5-bob";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "bobb2";
					qcom,supported-modes = <0x00 0x03 0x04>;

					pm_humu_bob2: BOB2: regulator-pm-humu-bob2 {
						regulator-max-microvolt = "", "2K";
						qcom,init-mode = <0x00>;
						qcom,init-voltage = <0x298100>;
						regulator-min-microvolt = <0x294280>;
						regulator-name = "pm_humu_bob2";
						qcom,set = <0x03>;
						phandle = <0x3fd>;
					};
				};

				rpmh-regulator-smpd3 {
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "smpd3";

					pm_v8d_s3: S3D: regulator-pm-v8d-s3 {
						regulator-max-microvolt = <0x13d620>;
						qcom,init-voltage = <0x12ad40>;
						regulator-min-microvolt = <0x124f80>;
						regulator-name = "pm_v8d_s3";
						qcom,set = <0x03>;
						phandle = <0x3ff>;
					};
				};

				rpmh-regulator-ldok4 {
					qcom,mode-threshold-currents = <0x00 0x7530>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldok4";
					qcom,supported-modes = <0x02 0x04>;

					L4K: pmr_nalojr_l4: regulator-pmr-nalojr-l4 {
						regulator-max-microvolt = <0x124f80>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x124f80>;
						regulator-min-microvolt = <0x124f80>;
						regulator-name = "pmr_nalojr_l4";
						qcom,set = <0x03>;
						phandle = <0x41b>;
					};
				};

				rpmh-regulator-smpg1 {
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "smpg1";

					pm_v8g_s1: S1G: regulator-pm-v8g-s1 {
						regulator-max-microvolt = <0xaae60>;
						qcom,init-voltage = <0x7a120>;
						regulator-min-microvolt = <0x493e0>;
						regulator-name = "pm_v8g_s1";
						qcom,set = <0x03>;
						phandle = <0x409>;
					};
				};

				rpmh-regulator-ldon2 {
					qcom,mode-threshold-currents = <0x00 0x7530>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldon2";
					qcom,supported-modes = <0x02 0x04>;

					pm8010n_l2: L2N: regulator-pm8010n-l2 {
						regulator-max-microvolt = <0x10d880>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x10d880>;
						regulator-min-microvolt = <0x10d880>;
						regulator-name = "pm8010n_l2";
						qcom,set = <0x03>;
						phandle = <0x427>;
					};
				};

				rpmh-regulator-ldom2 {
					qcom,mode-threshold-currents = <0x00 0x7530>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldom2";
					qcom,supported-modes = <0x02 0x04>;

					L2M: pm8010m_l2: regulator-pm8010m-l2 {
						regulator-max-microvolt = <0x101d00>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x101d00>;
						regulator-min-microvolt = <0x101d00>;
						regulator-name = "pm8010m_l2";
						qcom,set = <0x03>;
						phandle = <0x420>;
					};
				};

				rpmh-regulator-ldob8 {
					qcom,mode-threshold-currents = <0x00 0x2710>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldob8";
					qcom,supported-modes = <0x02 0x04>;

					L8B: pm_humu_l8: regulator-pm-humu-l8 {
						regulator-max-microvolt = <0x2de600>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x1b7740>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "pm_humu_l8";
						qcom,set = <0x03>;
						phandle = <0x3f6>;
					};
				};

				rpmh-regulator-smpd1 {
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "smpd1";

					pm_v8d_s1: S1D: regulator-pm-v8d-s1 {
						regulator-max-microvolt = <0x10c8e0>;
						qcom,init-voltage = <0xee480>;
						regulator-min-microvolt = <0xd6d80>;
						regulator-name = "pm_v8d_s1";
						qcom,set = <0x03>;
						phandle = <0x3fe>;
					};
				};

				rpmh-regulator-ldok2 {
					qcom,mode-threshold-currents = <0x00 0x7530>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldok2";
					qcom,supported-modes = <0x02 0x04>;

					pmr_nalojr_l2: L2K: regulator-pmr-nalojr-l2 {
						regulator-max-microvolt = <0xf4240>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0xdea80>;
						regulator-min-microvolt = <0xdea80>;
						regulator-name = "pmr_nalojr_l2";
						qcom,set = <0x03>;
						phandle = <0x419>;
					};
				};

				rpmh-regulator-smpi8 {
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "smpi8";

					pm_v8i_s8: S8I: regulator-pm-v8i-s8 {
						regulator-max-microvolt = <0xed4e0>;
						qcom,init-voltage = <0xdcb40>;
						regulator-min-microvolt = <0xdbba0>;
						regulator-name = "pm_v8i_s8";
						qcom,set = <0x03>;
						phandle = <0x410>;
					};
				};

				rpmh-regulator-ldob16 {
					qcom,mode-threshold-currents = <0x00 0x2710>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldob16";
					qcom,supported-modes = <0x02 0x04>;

					L16B: pm_humu_l16: regulator-pm-humu-l16 {
						regulator-max-microvolt = <0x2dc6c0>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x2dc6c0>;
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-name = "pm_humu_l16";
						qcom,set = <0x03>;
						phandle = <0x3fa>;
					};
				};

				rpmh-regulator-ldoj2 {
					qcom,mode-threshold-currents = <0x00 0x7530>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldoj2";
					qcom,supported-modes = <0x01 0x04>;

					pm_v6j_l2: L2J: regulator-pm-v6j-l2 {
						regulator-max-microvolt = <0x124f80>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x124f80>;
						regulator-min-microvolt = <0x124f80>;
						regulator-name = "pm_v6j_l2";
						qcom,set = <0x03>;
						phandle = <0x46>;
					};
				};

				rpmh-regulator-ldoi2 {
					qcom,mode-threshold-currents = <0x00 0x7530>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldoi2";
					qcom,supported-modes = <0x01 0x04>;

					L2I: pm_v8i_l2: regulator-pm-v8i-l2 {
						regulator-max-microvolt = <0x124f80>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x124f80>;
						regulator-min-microvolt = <0x124f80>;
						regulator-name = "pm_v8i_l2";
						qcom,set = <0x03>;
						phandle = <0x412>;
					};
				};

				rpmh-regulator-ldob6 {
					qcom,mode-threshold-currents = <0x00 0x2710>;
					qcom,regulator-type = "pmic5-ldo";
					compatible = "qcom,rpmh-vrm-regulator";
					qcom,resource-name = "ldob6";
					qcom,supported-modes = <0x02 0x04>;

					L6B: pm_humu_l6: regulator-pm-humu-l6 {
						regulator-max-microvolt = <0x2de600>;
						qcom,init-mode = <0x04>;
						qcom,init-voltage = <0x1b7740>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "pm_humu_l6";
						qcom,set = <0x03>;
						phandle = <0x3f4>;
					};
				};

				rpmh-regulator-ebilvl {
					compatible = "qcom,rpmh-arc-regulator";
					qcom,resource-name = "ebi.lvl";

					pm_v8g_s2_level: VDD_EBI_LEVEL: S2G_LEVEL: regulator-pm-v8g-s2-level {
						regulator-max-microvolt = <0xffff>;
						regulator-min-microvolt = <0x10>;
						regulator-name = "pm_v8g_s2_level";
						qcom,init-voltage-level = <0x10>;
						qcom,set = <0x03>;
						phandle = <0x3eb>;
					};
				};

				rpmh-regulator-cxlvl {
					compatible = "qcom,rpmh-arc-regulator";
					qcom,resource-name = "cx.lvl";
					proxy-supply = <0x39>;

					S1J_LEVEL: pm_v6j_s1_level: VDD_CX_LEVEL: regulator-pm-v6j-s1-level {
						regulator-max-microvolt = <0xffff>;
						regulator-min-microvolt = <0x10>;
						regulator-name = "pm_v6j_s1_level";
						qcom,init-voltage-level = <0x180>;
						qcom,proxy-consumer-enable;
						qcom,set = <0x03>;
						phandle = <0x39>;
						qcom,proxy-consumer-voltage = <0x180 0xffff>;
					};

					VDD_CX_MMCX_SUPPLY_LEVEL: regulator-pm-v6j-s1-mmcx-sup-level {
						regulator-max-microvolt = <0xffff>;
						regulator-min-microvolt = <0x30>;
						regulator-name = "pm_v6j_s1_mmcx_sup_level";
						qcom,init-voltage-level = <0x30>;
						qcom,set = <0x03>;
						phandle = <0x3b>;
					};

					pm_v6j_s1_level_ao: S1J_LEVEL_AO: VDD_CX_LEVEL_AO: regulator-pm-v6j-s1-level-ao {
						regulator-max-microvolt = <0xffff>;
						regulator-min-microvolt = <0x10>;
						regulator-name = "pm_v6j_s1_level_ao";
						qcom,init-voltage-level = <0x10>;
						qcom,set = <0x01>;
						phandle = <0x3ed>;
					};
				};

				rpmh-regulator-ldog2 {
					qcom,mode-threshold-currents = <0x00 0x7530>;
					qcom,regulator-type = "pmic5-ldo";
