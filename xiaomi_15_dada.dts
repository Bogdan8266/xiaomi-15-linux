			reg = <0x00 0x100>;
			enable-method = "psci";
			phandle = <0x11>;
			#cooling-cells = <0x02>;
		};

		CPU4: cpu@400 {
			power-domains = <0x0a>;
			capacity-dmips-mhz = <0x700>;
			power-domain-names = "psci";
			clocks = <0x06 0x00>;
			cpu-idle-states = <0x03>;
