			phandle = <0x15>;
			#cooling-cells = <0x02>;
		};

		CPU0: cpu@0 {
			power-domains = <0x04>;
			capacity-dmips-mhz = <0x700>;
			power-domain-names = "psci";
			clocks = <0x06 0x00>;
			cpu-idle-states = <0x03>;
			device_type = "cpu";
			compatible = "arm,armv8";
			dynamic-power-coefficient = <0xee>;
			next-level-cache = <0x05>;
			reg = <0x00 0x00>;
			enable-method = "psci";
			phandle = <0x10>;
			#cooling-cells = <0x02>;

			L2_0: l2-cache {
				cache-level = <0x02>;
				compatible = "arm,arch-cache";
				phandle = <0x05>;
			};
		};

		CPU1: cpu@100 {
			power-domains = <0x07>;
			capacity-dmips-mhz = <0x700>;
