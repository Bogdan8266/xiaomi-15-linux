				pm8550-temp-alarm@a00 {
					interrupts = <0x01 0x0a 0x00 0x03>;
					io-channels = <0x655 0x103>;
					#thermal-sensor-cells = <0x00>;
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					phandle = <0x658>;
					io-channel-names = "thermal";
				};

				pinctrl@8800 {
					gpio-controller;
					compatible = "qcom,pm8550-gpio";
					#interrupt-cells = <0x02>;
					reg = <0x8800>;
					phandle = <0x68c>;
					#gpio-cells = <0x02>;
					interrupt-controller;

					pa_therm1 {

						pa_therm1_default {
							pins = "gpio3";
							bias-high-impedance;
							phandle = <0x66f>;
						};
					};

					display_panel_avdd_default {
						input-disable;
						function = "normal";
						pins = "gpio11";
						qcom,drive-strength = <0x03>;
						bias-disable;
						phandle = <0x79f>;
						output-enable;
						power-source = <0x01>;
					};

					display_therm {

						display_therm_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x672>;
						};
					};

					key_vol_up {

						key_vol_up_default {
							function = "normal";
							pins = "gpio6";
							phandle = <0x68b>;
							bias-pull-up;
							power-source = <0x01>;
							input-enable;
						};
					};

					conn_therm2 {

						conn_therm2_default {
							pins = "gpio4";
							bias-high-impedance;
							phandle = <0x670>;
						};
					};

					anti_burn_mos_ctrl {

						anti_burn_mos_ctrl_default {
							function = "normal";
							pins = "gpio9";
							phandle = <0x691>;
							output-enable;
							power-source = <0x00>;
						};
					};
				};

				led-controller {
					#address-cells = <0x01>;
					nvmem-names = "lpg_chan_sdam", "lut_sdam";
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					compatible = "qcom,pm8350c-pwm";
					nvmem = <0x656 0x657>;

					led@2 {
						color = <0x02>;
						label = "green";
						reg = <0x02>;
					};

					led@3 {
						color = <0x03>;
						label = "blue";
						reg = <0x03>;
					};

					led@1 {
