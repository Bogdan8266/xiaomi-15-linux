		tpdm_ipa: tpdm@10c22000 {
			arm,primecell-periphid = <0xbb968>;
			clock-names = "apb_pclk";
			reg-names = "tpdm-base";
			clocks = <0x19>;
			coresight-name = "coresight-tpdm-ipa";
			compatible = "arm,primecell";
			status = "disabled";
			reg = <0x10c22000 0x1000>;
			phandle = <0x4e2>;

			out-ports {

				port {

					tpdm_ipa_out_tn_ag: endpoint {
						remote-endpoint = <0x20a>;
						phandle = <0x223>;
					};
				};
			};
		};

		xiaomi_mi_trace {
			mt-size = <0x100000>;
			compatible = "xiaomi,mi_trace";
		};

		audio_etm0 {
			atid = <0x28 0x29>;
			qcom,atid-num = <0x02>;
			coresight-name = "coresight-audio-etm0";
			compatible = "qcom,coresight-remote-etm";
			trace-name = "audio-etm0";

			out-ports {

				port@0 {
					reg = <0x00>;

					audio_etm0_out_funnel_lpass_lpi: endpoint {
						remote-endpoint = <0x1f0>;
						phandle = <0x202>;
					};
				};

				port@1 {
					reg = <0x01>;

					audio_etm0_out_qmi: endpoint {
						remote-endpoint = <0x1f1>;
						phandle = <0x261>;
					};
				};
			};
		};

		gpucc: clock-controller@3d90000 {
			#reset-cells = <0x01>;
			clock-names = "bi_tcxo", "gpll0_out_main", "gpll0_out_main_div";
			clocks = <0x36 0x00 0x35 0x23 0x35 0x24>;
			#clock-cells = <0x01>;
			vdd_mx-supply = <0x38>;
			#power-domain-cells = <0x01>;
			compatible = "qcom,sun-gpucc", "syscon";
			reg-name = "cc_base";
			reg = <0x3d90000 0x9800>;
			phandle = <0x53>;
			vdd_cx-supply = <0x39>;
		};

		cpucp_log: qcom,cpucp_log@0x81210000 {
			compatible = "qcom,cpucp-log";
			reg = <0x81210000 0x10000 0x81220000 0x10000>;
			phandle = <0x45e>;
			mboxes = <0x4b 0x01>;
			qcom,log-type = <0x00>;
		};

		funnel_apss: funnel@12080000 {
			arm,primecell-periphid = <0xbb908>;
			qcom,atclk-dependence;
			clock-names = "apb_pclk", "atclk";
			reg-names = "funnel-base";
			clocks = <0x19 0x165 0x00>;
			coresight-name = "coresight-funnel-apss";
			compatible = "arm,primecell";
			reg = <0x12080000 0x1000>;
			phandle = <0x4c9>;

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					funnel_apss_in_apss_etf: endpoint {
						remote-endpoint = <0x1d5>;
